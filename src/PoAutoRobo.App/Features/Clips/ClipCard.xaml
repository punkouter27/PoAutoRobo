<UserControl
    x:Class="PoAutoRobo.App.Views.ClipCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PoAutoRobo.App.Views"
    xmlns:app="using:PoAutoRobo.App"
    PointerEntered="OnPointerEntered" PointerExited="OnPointerExited">
    <!-- Compact on purpose, and always the same height: the card shows a clip's state, and the inspector beside the deck changes it.
         A pane of frosted glass over the deck. -->
    <Border x:Name="Face" Width="{StaticResource CardWidth}" CornerRadius="8" Background="{ThemeResource GlassBrush}" BorderBrush="{ThemeResource GlassEdgeBrush}" BorderThickness="1">
    <StackPanel Spacing="4" Padding="4" ToolTipService.ToolTip="{x:Bind Card.Heading, Mode=OneWay}">
        <Grid x:Name="PictureArea" Height="{StaticResource CardPictureHeight}" CornerRadius="4" Background="{ThemeResource ControlAltFillColorSecondaryBrush}">
            <Image Source="{x:Bind local:ClipCard.ToImage(Card.ThumbnailPath), Mode=OneWay}" Stretch="UniformToFill" AutomationProperties.Name="Clip picture" />
            <!-- A badge for each kind of thing that needs attention, told apart by sign and colour; pointing at one says
                 what is wrong and what to do. The header counts the cards that carry any. -->
            <StackPanel Orientation="Horizontal" Spacing="4" Margin="6" HorizontalAlignment="Left" VerticalAlignment="Top" AutomationProperties.Name="{x:Bind Card.Warnings, Mode=OneWay}">
                <!-- The picture no longer matches the words: it wants making again -->
                <InfoBadge Style="{ThemeResource AttentionIconInfoBadgeStyle}" Visibility="{x:Bind app:Ui.ShowText(Card.StaleWarning), Mode=OneWay}" ToolTipService.ToolTip="{x:Bind Card.StaleWarning, Mode=OneWay}">
                    <InfoBadge.IconSource>
                        <FontIconSource Glyph="&#xE72C;" />
                    </InfoBadge.IconSource>
                </InfoBadge>
                <!-- The clip runs too short or too long for its slot -->
                <InfoBadge Style="{ThemeResource InformationalIconInfoBadgeStyle}" Visibility="{x:Bind app:Ui.ShowText(Card.LengthWarning), Mode=OneWay}" ToolTipService.ToolTip="{x:Bind Card.LengthWarning, Mode=OneWay}">
                    <InfoBadge.IconSource>
                        <FontIconSource Glyph="&#xE823;" />
                    </InfoBadge.IconSource>
                </InfoBadge>
                <!-- The words themselves: a figure not found in the sources, or an editor's note -->
                <InfoBadge Style="{ThemeResource CautionIconInfoBadgeStyle}" Visibility="{x:Bind app:Ui.ShowText(Card.CheckWarning), Mode=OneWay}" ToolTipService.ToolTip="{x:Bind Card.CheckTip, Mode=OneWay}" />
            </StackPanel>
            <!-- The clip's state in one strip: depth, picture type, length -->
            <Border Style="{StaticResource Badge}" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                    ToolTipService.ToolTip="Depth of explanation (A accessible, B applied, C advanced), picture type, and length: measured once the voice is recorded, estimated from the word count until then.">
                <TextBlock Text="{x:Bind Card.Summary, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
            </Border>
            <!-- Watch the clip on its own, with its sound. Shown under the pointer; the inspector's Play clip is the same, for the keyboard. -->
            <Button x:Name="PlayButton" Style="{StaticResource PlayOverPicture}" Opacity="0" Command="{x:Bind Card.WatchCommand, Mode=OneWay}"
                    AutomationProperties.Name="Watch this clip" ToolTipService.ToolTip="Watch this clip on its own, with its sound. Instant once the preview has been built.">
                <SymbolIcon Symbol="Play" />
            </Button>
            <!-- Something is being made for this clip right now; a render says how far it has got -->
            <Grid Background="{ThemeResource SmokeFillColorDefaultBrush}" Visibility="{x:Bind Card.Working, Mode=OneWay}">
                <ProgressRing IsActive="{x:Bind Card.Working, Mode=OneWay}" IsIndeterminate="{x:Bind Card.ProgressUnknown, Mode=OneWay}" Value="{x:Bind Card.Progress, Mode=OneWay}" Width="32" Height="32" />
            </Grid>
        </Grid>
        <TextBlock Text="{x:Bind Card.Heading, Mode=OneWay}" Style="{ThemeResource BodyStrongTextBlockStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
    </StackPanel>
    </Border>
</UserControl>
