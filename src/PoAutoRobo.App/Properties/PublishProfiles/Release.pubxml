<!--
  A build to hand out: everything it needs beside it, and compiled ahead of time (ReadyToRun) so the window opens
  sooner. It runs on the kind of machine that builds it (x64 or ARM64), as every build here does.
  dotnet publish src\PoAutoRobo.App -p:PublishProfile=Release
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishDir>bin\publish\</PublishDir>
  </PropertyGroup>
</Project>
